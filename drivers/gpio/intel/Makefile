obj-$(CONFIG_GPIO_SODAVILLE)		+= gpio-sodaville.o

# PCH type of drivers

obj-$(CONFIG_GPIO_ICH)			+= gpio-ich.o
obj-$(CONFIG_GPIO_ML_IOH)		+= gpio-ml-ioh.o
obj-$(CONFIG_GPIO_PCH)			+= gpio-pch.o
obj-$(CONFIG_GPIO_SCH)			+= gpio-sch.o

obj-y				+= pmic/
